# Copy only if needed; secrets belong in .env, never in Git.
# Uvicorn does not load .env automatically; export values in your terminal.
# Paths are relative to the project root unless absolute.
WISH_MANIFEST=data/manifest.local.json
WISH_KEYWORD_ONLY=0
