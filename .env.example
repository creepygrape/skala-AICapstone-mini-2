# Copy to .env only if needed; secrets belong in .env, never in Git.
# Uvicorn does not load .env itself: scripts/run_backend.sh sources it, or export values.
# Paths are relative to the project root unless absolute.
WISH_MANIFEST=data/manifest.local.json
WISH_KEYWORD_ONLY=0
# Agent graph (scripts/run_backend.sh forces 1; default off preserves A/B retrieval).
WISH_AGENT_ENABLED=0

# LLM backend switch: ollama (development, local, free) | openai (demo/submission, billed).
WISH_LLM_BACKEND=ollama
# Ollama models must already exist locally (no automatic download).
# route/rewrite use FAST, verify uses QUALITY. WISH_LLM_MODEL is the legacy single-model name.
WISH_OLLAMA_FAST_MODEL=qwen3:8b
WISH_OLLAMA_QUALITY_MODEL=qwen3:8b
# OpenAI: billed per request. In openai mode the user question and up to 3 candidate
# subtitle excerpts with their 20s context are sent to OpenAI (never full transcripts).
# OPENAI_API_KEY=sk-...
OPENAI_FAST_MODEL=gpt-4o-mini
# gpt-4o-mini keeps token cost low. A bigger fast model (e.g. gpt-4o) resolved at least one
# homonym failure in the Router (see docs/roadmap-and-design-notes.md) at a higher token price.
OPENAI_QUALITY_MODEL=gpt-4o

# Collection profile (subtitle language, translation note, known names): data/profile.local.json
# is read by default; see data/profile.example.json. Missing file = generic defaults.
# WISH_PROFILE=data/profile.local.json
# First round also searches the user's own words next to the Router's rewrite (ADR-0011).
# Off by default until measured on the gold set; scripts/run_backend.* and eval.run_eval read it.
# WISH_DUAL_QUERY=1
# Optional private diagnostic trace (contains subtitle text; eval/private or logs only).
# WISH_AGENT_TRACE=eval/private/traces
# LangSmith tracing (opt-in, needs BOTH WISH_LANGSMITH_ENABLED=1 and LANGSMITH_API_KEY).
# When on, every LLM call and graph node is uploaded INCLUDING the user question and the
# candidate subtitle excerpts (ADR-0008). Use a private/personal LangSmith workspace.
# Ambient LANGCHAIN_* variables alone never enable tracing here.
WISH_LANGSMITH_ENABLED=0
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=wish-finder
# Optional complete LOCAL bge-m3 directory. No automatic model download.
# WISH_EMBEDDING_PATH=/absolute/path/to/existing/model
