# Copy only if needed; secrets belong in .env, never in Git.
# Uvicorn does not load .env automatically; export values in your terminal.
# Paths are relative to the project root unless absolute.
WISH_MANIFEST=data/manifest.local.json
WISH_KEYWORD_ONLY=0
# Day 2 JSON Agent (default off preserves A/B retrieval).
WISH_AGENT_ENABLED=0
# Must already exist in local Ollama. No automatic download or paid fallback.
WISH_LLM_MODEL=qwen3:8b
# Optional metadata-only summaries; raw graph State is never auto-traced.
WISH_LANGSMITH_ENABLED=0
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=wish-finder
# Optional complete LOCAL bge-m3 directory. No automatic model download.
# WISH_EMBEDDING_PATH=/absolute/path/to/existing/model
